# Copy this file to .env and fill in the blank values before starting the app.
# PORT is the port the browser connects to on the host.
PORT=3000
# Paste the Atlas Drivers connection string with /taskflow before its query options.
MONGODB_URI=
# Generate 64 random hexadecimal characters with openssl rand -hex 32.
SESSION_SECRET=
# Keep false for local HTTP. Set true when the app is served over HTTPS.
COOKIE_SECURE=false
# Set true only if the app is behind one trusted reverse proxy.
TRUST_PROXY=false
