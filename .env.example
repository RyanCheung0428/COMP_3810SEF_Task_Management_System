# Copy this file to .env and fill in the blank values before starting the demo.
# PORT is the port the browser connects to on the host.
PORT=3000
# mongo is the database service name inside the Compose network.
MONGODB_URI=mongodb://mongo:27017/taskflow
# Generate 64 random hexadecimal characters with openssl rand -hex 32.
SESSION_SECRET=
# The seed command uses this password to create the demo accounts.
DEMO_PASSWORD=
# Keep false for local HTTP. Set true when the app is served over HTTPS.
COOKIE_SECURE=false
# Set true only if the app is behind one trusted reverse proxy.
TRUST_PROXY=false
