<%- include('partials/header', { title: heading }) %>
<section class="panel form-panel">
  <h1><%= heading %></h1>
  <form method="post" action="/api/tasks" id="task-form" class="stack" data-task-id="<%= taskId %>" data-view="<%= completed ? 'completed' : '' %>">
    <fieldset id="task-fields" class="stack" disabled>
      <div>
        <label for="title">Title</label>
        <input id="title" name="title" maxlength="120" aria-describedby="title-error" required>
        <p class="field-error" id="title-error" hidden></p>
      </div>
      <div>
        <label for="description">Description <span class="optional">(optional)</span></label>
        <textarea id="description" name="description" rows="4" maxlength="1000" aria-describedby="description-error"></textarea>
        <p class="field-error" id="description-error" hidden></p>
      </div>
      <div>
        <label for="dueDate">Due date <span class="optional">(optional)</span></label>
        <input id="dueDate" name="dueDate" type="date" aria-describedby="dueDate-error">
        <p class="field-error" id="dueDate-error" hidden></p>
      </div>
      <div class="actions">
        <button class="button" type="submit">Save task</button>
        <a class="button button-secondary" href="/tasks<%= completed ? '?view=completed' : '' %>">Cancel</a>
      </div>
    </fieldset>
  </form>
</section>
<%- include('partials/footer') %>
