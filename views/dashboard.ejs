<%# Show the task counts and completion rate the server calculated for this user. -%>
<%- include('partials/header', { title: 'Dashboard', page: 'dashboard' }) %>
<div class="page-heading">
  <h1>Dashboard</h1>
  <a class="button" href="/tasks/new">Add task</a>
</div>
<dl class="stats">
  <div class="panel"><dt>Total tasks</dt><dd><%= stats.total %></dd></div>
  <div class="panel"><dt>Pending</dt><dd><%= stats.pending %></dd></div>
  <div class="panel"><dt>In progress</dt><dd><%= stats.inProgress %></dd></div>
  <div class="panel"><dt>Completed</dt><dd><%= stats.completed %></dd></div>
</dl>
<%# The heading labels the progress bar, which runs from 0 to 100 percent. -%>
<section class="panel">
  <h2 id="completion-label">Completion rate: <%= stats.percentage %>%</h2>
  <progress aria-labelledby="completion-label" value="<%= stats.percentage %>" max="100"><%= stats.percentage %>%</progress>
</section>
<%- include('partials/footer') %>
