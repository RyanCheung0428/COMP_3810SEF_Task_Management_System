<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | TaskFlow</title>
  <link rel="stylesheet" href="/styles.css">
  <script src="/forms.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/">TaskFlow</a>
      <nav aria-label="Main navigation" id="account-nav" hidden>
        <form method="post" action="/api/auth/logout" data-auth="logout">
          <button class="button button-secondary" type="submit">Log out</button>
        </form>
      </nav>
    </div>
  </header>
  <main id="main-content" class="container" tabindex="-1">
    <p class="notice notice-error" id="request-error" role="alert" hidden></p>
    <noscript>Enable JavaScript to sign in and manage tasks.</noscript>
