<%- include('partials/header', { title: 'Log in' }) %>
<section class="panel narrow">
  <h1>Log in</h1>
  <p class="notice notice-error" role="alert" hidden></p>
  <p class="notice notice-success" role="status" hidden></p>
  <form method="post" action="/api/auth/login" data-auth="login" class="stack">
    <div>
      <label for="username">Username</label>
      <input id="username" name="username" autocomplete="username" required>
    </div>
    <div>
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>
    </div>
    <div><a href="/forgot-password">Forgot password?</a></div>
    <button class="button" type="submit">Log in</button>
  </form>
  <a class="button button-register auth-link" href="/register">Create account</a>
</section>
<%- include('partials/footer') %>
