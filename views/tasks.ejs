<%- include('partials/header', { title: 'Tasks' }) %>
<div id="task-page" data-view="<%= completed ? 'completed' : '' %>" data-search-title="<%= searchTitle %>">
  <div class="page-heading">
    <form id="task-search" class="task-search" method="get" action="/tasks" role="search">
      <label class="visually-hidden" for="task-search-title">Search tasks by title</label>
      <% if (completed) { %><input type="hidden" name="view" value="completed"><% } %>
      <svg class="task-search-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="10.5" cy="10.5" r="6.5"></circle>
        <path d="m15.5 15.5 4.5 4.5"></path>
      </svg>
      <input id="task-search-title" name="title" type="search" maxlength="120" placeholder="Search by title" value="<%= searchTitle %>" autocomplete="off">
      <button id="clear-task-search" class="task-search-clear" type="button" aria-label="Clear title search"<% if (!searchTitle) { %> hidden<% } %>>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m7 7 10 10M17 7 7 17"></path></svg>
      </button>
    </form>
    <a class="button" id="add-task" href="/tasks/new<%= viewQuery %>">Add task</a>
  </div>
  <nav class="stats" aria-label="Task status">
    <a class="panel stat" data-view="" href="<%= inProgressUrl %>"<% if (!completed) { %> aria-current="page"<% } %>>
      <span>In progress</span>
      <strong id="unfinished-count"></strong>
    </a>
    <a class="panel stat" data-view="completed" href="<%= completedUrl %>"<% if (completed) { %> aria-current="page"<% } %>>
      <span>Completed</span>
      <strong id="completed-count"></strong>
    </a>
  </nav>
  <p class="notice notice-success" role="status" hidden></p>
  <div class="panel empty" hidden>
    <h2><%= searchTitle ? 'No matching tasks' : completed ? 'No completed tasks yet' : 'No unfinished tasks' %></h2>
  </div>
  <ul class="panel task-list" hidden></ul>
</div>
<template id="task-row">
  <li class="task">
    <button class="task-control" type="button" data-task-action="toggle">
      <span class="task-check" aria-hidden="true"></span>
    </button>
    <div class="task-content">
      <h2></h2>
      <p class="description" hidden></p>
      <p class="task-date" hidden>
        Due <time></time> <span class="overdue" hidden>Overdue</span>
      </p>
    </div>
    <details class="task-options">
      <summary class="task-control"><span aria-hidden="true">⋯</span></summary>
      <div class="task-options-panel">
        <a href="#">Edit</a>
        <button class="delete-task" type="button" data-task-action="delete">Delete</button>
      </div>
    </details>
  </li>
</template>
<%- include('partials/footer') %>
