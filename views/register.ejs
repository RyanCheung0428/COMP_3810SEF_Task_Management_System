<%- include('partials/header', { title: 'Create account' }) %>
<section class="panel narrow">
  <h1>Create account</h1>
  <p class="notice notice-error" role="alert" hidden></p>
  <form method="post" action="/api/auth/register" data-auth="register" class="stack">
    <div>
      <label for="username">Username</label>
      <input id="username" name="username" autocomplete="username" required>
    </div>
    <div>
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required>
    </div>
    <button class="button button-register" type="submit">Create account</button>
  </form>
  <a class="button auth-link" href="/login">Log in</a>
</section>
<%- include('partials/footer') %>
